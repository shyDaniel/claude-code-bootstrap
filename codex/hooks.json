{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash __CODEX_DIR__/hooks/protect-files.sh",
            "statusMessage": "Checking protected files"
          }
        ]
      }
    ]
  }
}
